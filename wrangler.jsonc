{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shelfnstir",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".deploy",
    "binding": "ASSETS"
  }
}
